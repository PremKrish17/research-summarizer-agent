{
  "info": {
    "name": "Research Summarizer Agent - API Test Scenarios",
    "description": "17 API scenarios, most important first, edge cases last.\n\nStart the app first (docker compose up --build, or ./mvnw spring-boot:run).\nScenarios 15-17 need a separate test container: see each request's description.\n\nEvery request has automatic checks: see the Test Results tab after sending.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Main scenarios (routing)",
      "item": [
        {
          "name": "01. OpenAI topic -> MCP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"searchSource is MCP\", () => pm.expect(pm.response.json().searchSource).to.eql(\"MCP\"));",
                  "pm.test(\"report has all sections\", () => { const r = pm.response.json(); pm.expect(r.executiveSummary).to.be.a(\"string\").and.not.empty; pm.expect(r.keyFindings).to.be.an(\"array\").and.not.empty; pm.expect(r.details).to.be.a(\"string\").and.not.empty; pm.expect(r.sources).to.be.an(\"array\").and.not.empty; });",
                  "pm.test(\"X-Trace-Id header is present\", () => pm.response.to.have.header(\"X-Trace-Id\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/research/summarize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "research",
                "summarize"
              ]
            },
            "description": "Most important scenario. An OpenAI developer topic is answered from the OpenAI Docs MCP server.\n\nExpected: 200, searchSource MCP, sources from developers.openai.com. Takes about 30-90 s.",
            "body": {
              "mode": "raw",
              "raw": "{ \"topic\": \"How does streaming work in the OpenAI Responses API?\", \"maxSources\": 3 }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
