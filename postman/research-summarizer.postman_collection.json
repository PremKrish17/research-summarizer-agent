                  "pm.test(\"report has all sections\", () => { const r = pm.response.json(); pm.expect(r.executiveSummary).to.be.a(\"string\").and.not.empty; pm.expect(r.keyFindings).to.be.an(\"array\").and.not.empty; pm.expect(r.details).to.be.a(\"string\").and.not.empty; pm.expect(r.sources).to.be.an(\"array\").and.not.empty; });"
                ]
              }
            }
