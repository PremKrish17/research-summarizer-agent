# YOU MUST ADD YOUR OWN API KEYS. The app does not work without them.
#
# 1. Copy this file to a new file named .env   (cp .env.example .env)
# 2. Paste your own keys after the = signs below (no quotes, no spaces).
#
# .env is gitignored, so your keys are never pushed to Git. The app (mvnw) and docker compose both read .env.
# The OpenAI Docs MCP server needs no key.

# Used by Agents 2 and 3 (the LLM). Free key: https://openrouter.ai/keys
# Without it, the app stops at startup with "OPENROUTER_API_KEY is not set".
OPENROUTER_API_KEY=

# Used by Agent 1 for web search. Free key: https://app.tavily.com
# Without it, every topic that needs web search fails with error 500.
TAVILY_API_KEY=
